{
  "name": "prerenderwebnodeplugin",
  "version": "1.0.356",
  "description": "Pre-rendering hook for web-node applications.",
  "keywords": [
    "web",
    "backend",
    "static",
    "prerender",
    "prerendering",
    "pre-render",
    "pre-rendering"
  ],
  "homepage": "https://tsickert.com/pre-render-web-node-plugin",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/pre-render-web-node-plugin/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/pre-render-web-node-plugin.git"
  },
  "main": "index.js",
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "weboptimizer build:types && weboptimizer build",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build && yarn start",
    "start": "web-node '{plugin: {hotReloading: true}}'",
    "test": "weboptimizer test",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "clientnode": "^4.0.1529",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "typescript-eslint": "^8.72.1",
    "web-documentation": "^1.0.68",
    "web-node": "^1.0.638",
    "weboptimizer": "^4.0.109"
  },
  "peerDependencies": {
    "clientnode": "*",
    "web-node": "*"
  },
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "name": "pre-render-web-node-plugin"
  },
  "webNode": {
    "preRender": {
      "cache": false,
      "locations": {
        "executer": {
          "exclude": [
            "backup",
            "database",
            "log",
            "mockup",
            "node_modules",
            "src",
            "source"
          ],
          "fileNames": [
            "pre-render.js",
            "pre-renderer.js",
            "preRender.js",
            "preRenderer.js"
          ],
          "include": []
        },
        "output": {
          "directoryNames": "preRendered",
          "exclude": []
        }
      },
      "renderAfterConfigurationUpdates": false
    }
  },
  "webNodeInternalName": "preRender",
  "webOptimizer": {
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
