{
  "name": "prerenderwebnodeplugin",
  "version": "1.0.357",
  "description": "Pre-rendering hook for web-node applications.",
  "keywords": [
    "web",
    "backend",
    "static",
    "prerender",
    "prerendering",
    "pre-render",
    "pre-rendering"
  ],
  "homepage": "https://tsickert.com/pre-render-web-node-plugin",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/pre-render-web-node-plugin/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/pre-render-web-node-plugin.git"
  },
  "main": "index.js",
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "weboptimizer build:types && weboptimizer build",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build && yarn start",
    "start": "web-node '{plugin: {hotReloading: true}}'",
    "test": "weboptimizer test",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.10",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "typescript-eslint": "^8.74.0",
    "web-documentation": "^1.0.77",
    "web-node": "^1.0.644",
    "weboptimizer": "^4.0.125"
  },
  "peerDependencies": {
    "clientnode": "*",
    "core-js": "*",
    "web-node": "*"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "name": "pre-render-web-node-plugin"
  },
  "webNode": {
    "preRender": {
      "cache": false,
      "locations": {
        "executer": {
          "exclude": [
            "backup",
            "database",
            "log",
            "mockup",
            "node_modules",
            "src",
            "source"
          ],
          "fileNames": [
            "pre-render.js",
            "pre-renderer.js",
            "preRender.js",
            "preRenderer.js"
          ],
          "include": []
        },
        "output": {
          "directoryNames": "preRendered",
          "exclude": []
        }
      },
      "renderAfterConfigurationUpdates": false
    }
  },
  "webNodeInternalName": "preRender",
  "webOptimizer": {
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
